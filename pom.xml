<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.mulesoft.support.batchhttp</groupId>
    <artifactId>batch-http-appender-parent</artifactId>
    <version>0.1.6</version>
    <packaging>pom</packaging>
    <name>Batch HTTP Appender (parent)</name>
    <description>A batching HTTP log shipper for Datadog, Splunk HEC, New Relic, Dynatrace, Elasticsearch and any HTTP log intake.</description>
    <url>https://github.com/mulesoft/batch-http-log-appender</url>

    <!--
      Declared once here so every reactor module inherits it; matches LICENSE.txt and the
      SPDX-License-Identifier header carried by each source file.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/mulesoft/batch-http-log-appender.git</connection>
        <developerConnection>scm:git:git@github.com:mulesoft/batch-http-log-appender.git</developerConnection>
        <url>https://github.com/mulesoft/batch-http-log-appender</url>
        <tag>HEAD</tag>
    </scm>

    <modules>
        <module>batch-http-core</module>
        <module>batch-http-log4j2</module>
        <module>demo/java/benchmark</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!--
          Third-party versions are pinned here and kept current as a security requirement:
          run `mvn versions:display-dependency-updates` (and `:display-plugin-updates`) to
          see what is stale, and `mvn -Psecurity verify` to scan for known CVEs (OWASP
          dependency-check). Stay on the log4j *2.x* line: the Mule runtime supplies log4j 2.x
          on its container classloader, so a 3.x bump here would diverge from what actually
          runs and is excluded at runtime anyway.
        -->
        <log4j.version>2.26.0</log4j.version>
        <junit.version>5.14.4</junit.version>
        <surefire.version>3.5.6</surefire.version>
        <compiler.plugin.version>3.16.0</compiler.plugin.version>
        <versions.plugin.version>2.21.0</versions.plugin.version>
        <dependency.check.version>12.2.2</dependency.check.version>
        <license.plugin.version>5.0.0</license.plugin.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.mulesoft.support.batchhttp</groupId>
                <artifactId>batch-http-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.logging.log4j</groupId>
                <artifactId>log4j-core</artifactId>
                <version>${log4j.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${surefire.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${compiler.plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!--
              Dependency-currency reporting. `mvn versions:display-dependency-updates` and
              `versions:display-plugin-updates` flag any third-party artifact (or plugin) that
              has a newer release, so staying on patched, non-vulnerable versions is a routine
              check rather than a guess. Reporting only — it never changes the build.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>${versions.plugin.version}</version>
            </plugin>

            <!--
              Apache-2.0/SPDX header enforcement. `mvn license:format` stamps (or repairs) the
              header on every Salesforce-authored source and config file; the `check` execution
              below fails `validate` if one is missing, so headers cannot silently regress.
              Runs only from the root (`inherited=false`) over an explicit include list, because
              samples/demos are exempt from the header requirement and `demo/**` therefore must
              never be stamped.
            -->
            <plugin>
                <groupId>com.mycila</groupId>
                <artifactId>license-maven-plugin</artifactId>
                <version>${license.plugin.version}</version>
                <inherited>false</inherited>
                <configuration>
                    <!-- Walk the whole tree from the root; without this Maven module directories are skipped. -->
                    <aggregate>true</aggregate>
                    <licenseSets>
                        <licenseSet>
                            <header>build-tools/license-header.txt</header>
                            <includes>
                                <include>pom.xml</include>
                                <include>batch-http-core/pom.xml</include>
                                <include>batch-http-log4j2/pom.xml</include>
                                <include>batch-http-core/src/**/*.java</include>
                                <include>batch-http-log4j2/src/**/*.java</include>
                                <include>batch-http-log4j2/src/**/log4j2*.xml</include>
                                <include>docs/index.html</include>
                            </includes>
                            <excludes>
                                <exclude>demo/**</exclude>
                                <exclude>**/target/**</exclude>
                            </excludes>
                        </licenseSet>
                    </licenseSets>
                    <headerDefinitions>
                        <headerDefinition>build-tools/license-header-styles.xml</headerDefinition>
                    </headerDefinitions>
                    <mapping>
                        <java>SLASHSTAR_STYLE</java>
                        <xml>XML_STYLE</xml>
                        <html>html_doctype_style</html>
                    </mapping>
                </configuration>
                <executions>
                    <execution>
                        <id>check-license-headers</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          CVE gate. `mvn -Psecurity verify` runs OWASP dependency-check against the NVD over the
          whole reactor and FAILS the build on any dependency with a CVSS >= 7 (high/critical),
          so a vulnerable transitive cannot ship unnoticed. Kept in an opt-in profile because a
          full NVD scan is slow and needs network/an NVD API key; wire it into CI (nightly or
          pre-release) rather than every local `mvn install`. Tune via -Dnvd.api.key=... and
          -DfailBuildOnCVSS=...; suppress accepted findings with a dependency-check-suppressions.xml.
        -->
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>${dependency.check.version}</version>
                        <configuration>
                            <!-- High/critical CVEs fail the build; lower-severity findings are reported. -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- The core jar has no runtime deps, so the JDK-only assembly/retire analyzers add noise. -->
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                            <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                            <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
