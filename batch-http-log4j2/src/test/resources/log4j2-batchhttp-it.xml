<!--
  Integration test configuration for BatchHttpAppender.

  This drives the appender through Log4j2's real plugin-discovery and
  attribute-binding path (the `packages` scan finds <BatchHttp>, and every
  attribute below is bound by name), exactly as a customer's log4j2.xml would.
  The test asserts on the appender built from THIS file, so it can never drift
  out of sync with the @PluginFactory signature — adding or reordering a factory
  parameter changes nothing here.

  The intake URL is injected at parse time from a system property the test sets
  to its randomly-allocated local HTTP server: ${sys:batchhttp.it.url}.
-->
<Configuration status="WARN" packages="com.mulesoft.support.batchhttp.log4j2">

    <Appenders>
        <BatchHttp name="testBatch"
                   vendor="generic"
                   url="${sys:batchhttp.it.url}"
                   maxBatchRecords="50"
                   maxBatchBytes="1048576"
                   lingerMillis="100"
                   queueCapacity="100000"
                   gzip="true"
                   includeStackTrace="true"
                   spillEnabled="false">
            <PatternLayout pattern="%m"/>
        </BatchHttp>
    </Appenders>

    <Loggers>
        <Logger name="com.mulesoft.support.batchhttp.it" level="INFO" additivity="false">
            <AppenderRef ref="testBatch"/>
        </Logger>
        <!-- Keep everything else silent so the intake only ever sees this test's events. -->
        <Root level="OFF"/>
    </Loggers>
</Configuration>
